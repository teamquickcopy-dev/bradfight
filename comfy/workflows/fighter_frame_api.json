{
  "1": {
    "class_type": "CheckpointLoaderSimple",
    "_meta": {"title": "Checkpoint (SDXL)"},
    "inputs": {"ckpt_name": "sd_xl_base_1.0.safetensors"}
  },
  "2": {
    "class_type": "LoraLoader",
    "_meta": {"title": "Character LoRA (identity lock)"},
    "inputs": {"model": ["1", 0], "clip": ["1", 1], "lora_name": "character.safetensors",
               "strength_model": 0.9, "strength_clip": 0.9}
  },
  "3": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Positive prompt"},
    "inputs": {"clip": ["2", 1], "text": "full body fighting game character, side view, facing right, plain white background"}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative prompt"},
    "inputs": {"clip": ["2", 1], "text": "background scenery, shadow, floor, cropped, extra limbs, blurry, text"}
  },
  "5": {
    "class_type": "LoadImage",
    "_meta": {"title": "OpenPose pass"},
    "inputs": {"image": "fighter/openpose.png"}
  },
  "6": {
    "class_type": "LoadImage",
    "_meta": {"title": "Depth pass"},
    "inputs": {"image": "fighter/depth.png"}
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {"title": "Clay pass (img2img init)"},
    "inputs": {"image": "fighter/clay.png"}
  },
  "8": {
    "class_type": "ControlNetLoader",
    "_meta": {"title": "ControlNet OpenPose"},
    "inputs": {"control_net_name": "controlnet-openpose-sdxl.safetensors"}
  },
  "9": {
    "class_type": "ControlNetLoader",
    "_meta": {"title": "ControlNet Depth"},
    "inputs": {"control_net_name": "controlnet-depth-sdxl.safetensors"}
  },
  "10": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {"title": "Apply OpenPose"},
    "inputs": {"positive": ["3", 0], "negative": ["4", 0], "control_net": ["8", 0], "image": ["5", 0],
               "vae": ["1", 2], "strength": 1.0, "start_percent": 0.0, "end_percent": 1.0}
  },
  "11": {
    "class_type": "ControlNetApplyAdvanced",
    "_meta": {"title": "Apply Depth"},
    "inputs": {"positive": ["10", 0], "negative": ["10", 1], "control_net": ["9", 0], "image": ["6", 0],
               "vae": ["1", 2], "strength": 0.5, "start_percent": 0.0, "end_percent": 0.8}
  },
  "12": {
    "class_type": "EmptyLatentImage",
    "_meta": {"title": "Empty latent (txt2img)"},
    "inputs": {"width": 1024, "height": 1024, "batch_size": 1}
  },
  "13": {
    "class_type": "VAEEncode",
    "_meta": {"title": "Encode clay (img2img)"},
    "inputs": {"pixels": ["7", 0], "vae": ["1", 2]}
  },
  "14": {
    "class_type": "KSampler",
    "_meta": {"title": "Sampler (fixed seed for every frame)"},
    "inputs": {"model": ["2", 0], "positive": ["11", 0], "negative": ["11", 1], "latent_image": ["12", 0],
               "seed": 1234, "steps": 28, "cfg": 6.0, "sampler_name": "dpmpp_2m", "scheduler": "karras",
               "denoise": 1.0}
  },
  "15": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["14", 0], "vae": ["1", 2]}
  },
  "16": {
    "class_type": "SaveImage",
    "_meta": {"title": "Save (driver copies it to 01_raw)"},
    "inputs": {"images": ["15", 0], "filename_prefix": "fighter/frame"}
  }
}
