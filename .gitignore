# Third-party, fetched by tools/setup_engine.py: Ikemen GO (MIT) and its bundled kfm720 template (Elecbyte)
/engine/
/templates/fighter_base/*
!/templates/fighter_base/.gitkeep

# Generated per character (renders, cutouts, aligned frames, .sff builds)
/characters/*/01_raw/
/characters/*/02_cutout/
/characters/*/03_aligned/
/characters/*/04_build/
/characters/*/portraits/
/characters/_example/

# Blender control passes (large, regenerated by rigs/render_passes.py)
/comfy/pose_maps/*
!/comfy/pose_maps/.gitkeep

# Generated stage outputs (previews include the KFM-based greybox fighter)
/stages/src/*/build/
/stages/src/*/preview*.png
/docs/crt_compare.png

# Local settings that may hold your own model names / links
/comfy/*.settings.json

__pycache__/
*.pyc
.DS_Store
